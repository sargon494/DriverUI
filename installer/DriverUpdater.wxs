<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instalador MSI de DriverUpdater (WiX v4).
  Registra el servicio de Windows (Agent.Service, cuenta LocalSystem, inicio bajo demanda)
  e instala la UI (Ui.Wpf, sin elevación) con acceso desde el menú Inicio.
  Compilar con installer/build.ps1. Variables: Version, AgentServiceDir, UiDir.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="DriverUpdater"
           Manufacturer="sargon494"
           Version="$(var.Version)"
           UpgradeCode="5E96540A-DE12-4F4E-8161-47A478F4CF7C"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente de DriverUpdater instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="REMOVEAPPDATA" Secure="yes" />
    <Property Id="APPDATADIR" Value="%ProgramData%\DriverUpdater" />

    <UI>
      <Dialog Id="UninstallDataDialog"
              Width="370"
              Height="170"
              Title="Desinstalar DriverUpdater">
        <Control Id="DialogTitle"
                 Type="Text"
                 X="18"
                 Y="16"
                 Width="334"
                 Height="20"
                 Text="¿Qué quieres hacer con los datos locales?" />
        <Control Id="DialogDescription"
                 Type="Text"
                 X="18"
                 Y="42"
                 Width="334"
                 Height="42"
                 Text="Se conservan por defecto. Puedes eliminar el historial, los ajustes y los registros guardados en %ProgramData%\DriverUpdater. Esta acción no se puede deshacer." />
        <Control Id="RemoveDataCheckBox"
                 Type="CheckBox"
                 X="18"
                 Y="91"
                 Width="334"
                 Height="20"
                 Property="REMOVEAPPDATA"
                 CheckBoxValue="1"
                 Text="Eliminar los datos locales de DriverUpdater" />
        <Control Id="CancelUninstall"
                 Type="PushButton"
                 X="193"
                 Y="135"
                 Width="75"
                 Height="22"
                 Text="Cancelar"
                 Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="ContinueUninstall"
                 Type="PushButton"
                 X="277"
                 Y="135"
                 Width="75"
                 Height="22"
                 Text="Desinstalar"
                 Default="yes">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="UninstallDataDialog"
              Before="ExecuteAction"
              Condition="REMOVE=&quot;ALL&quot; AND UILevel &gt;= 4 AND NOT UPGRADINGPRODUCTCODE" />
      </InstallUISequence>
    </UI>

    <Feature Id="Main" Title="DriverUpdater" Level="1">
      <ComponentRef Id="AgentServiceComponent" />
      <ComponentRef Id="UiComponent" />
      <ComponentRef Id="ComplianceFilesComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <!-- Permiso para que los usuarios interactivos INICIEN y DETENGAN el servicio (RP/WP),
         sin poder cambiar su configuración. Se aplica tras instalar el servicio. -->
    <CustomAction Id="GrantInteractiveStartStop"
                  Directory="SystemFolder"
                  ExeCommand='sc.exe sdset DriverUpdater "D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPWPDTLOCRRC;;;IU)"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="GrantInteractiveStartStop" After="InstallServices" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- Carpeta de instalación: Program Files\DriverUpdater -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DriverUpdater">

        <!-- Servicio de Windows: el propio binario de Agent.Service -->
        <Component Id="AgentServiceComponent" Guid="80E3759C-18F3-417F-B16C-DDCB5BD035EB" Bitness="always64">
          <util:RemoveFolderEx Id="RemoveAppDataFolder"
                               Property="APPDATADIR"
                               On="uninstall"
                               Condition="REMOVEAPPDATA=1 AND NOT UPGRADINGPRODUCTCODE" />
          <File Id="AgentServiceExe"
                Source="$(var.AgentServiceDir)\Agent.Service.exe"
                KeyPath="yes" />

          <!-- Cuenta SYSTEM: necesaria para WMI, WUA y pnputil. La ACL del pipe la aplica el propio servicio. -->
          <ServiceInstall Id="DriverUpdaterServiceInstall"
                          Name="DriverUpdater"
                          DisplayName="DriverUpdater Agent"
                          Description="Detecta e instala actualizaciones de controladores firmadas, con punto de restauración y rollback."
                          Type="ownProcess"
                          Start="demand"
                          ErrorControl="normal"
                          Account="LocalSystem"
                          Vital="yes" />

          <!-- Se inicia bajo demanda desde la UI y se detiene y elimina al desinstalar -->
          <ServiceControl Id="DriverUpdaterServiceControl"
                          Name="DriverUpdater"
                          Start="none"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- UI WPF: se ejecuta como usuario normal (asInvoker), nunca elevada -->
        <Component Id="UiComponent" Guid="3A32F528-A2CF-48B4-9949-5DDA1446176F" Bitness="always64">
          <File Id="UiExe"
                Source="$(var.UiDir)\Ui.Wpf.exe"
                KeyPath="yes" />
        </Component>

        <!-- Licencia del proyecto, avisos de dependencias y SBOM de esta versión -->
        <Component Id="ComplianceFilesComponent" Guid="2D4DDFAB-14C7-4DB6-9D2F-7C823B38B34D" Bitness="always64">
          <File Id="ProjectLicenseFile"
                Source="$(var.ProjectLicenseFile)"
                Name="LICENSE.txt"
                KeyPath="yes" />
          <File Id="ThirdPartyNoticesFile"
                Source="$(var.ThirdPartyNoticesFile)"
                Name="THIRD-PARTY-NOTICES.txt" />
          <File Id="ApacheLicenseFile"
                Source="$(var.ApacheLicenseFile)"
                Name="LICENSE-APACHE-2.0.txt" />
          <File Id="BsdLicenseFile"
                Source="$(var.BsdLicenseFile)"
                Name="LICENSE-BSD-3-Clause.txt" />
          <File Id="SbomFile"
                Source="$(var.SbomFile)"
                Name="SBOM.cdx.json" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- Acceso directo en el menú Inicio -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="DriverUpdater">
        <Component Id="StartMenuShortcutComponent" Guid="E1E13C38-E322-4149-88FE-31D7DB7741D4">
          <Shortcut Id="UiStartMenuShortcut"
                    Name="DriverUpdater"
                    Description="Abrir DriverUpdater"
                    Target="[INSTALLFOLDER]Ui.Wpf.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\DriverUpdater"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Acceso directo en el escritorio del usuario que instala -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="C4C5512C-1D24-4E5B-952B-3C33E5529E92">
        <Shortcut Id="UiDesktopShortcut"
                  Name="DriverUpdater"
                  Description="Abrir DriverUpdater"
                  Target="[INSTALLFOLDER]Ui.Wpf.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\DriverUpdater"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Package>
</Wix>
