<UserControl x:Class="Ui.Wpf.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ui.Wpf.ViewModels"
             xmlns:conv="clr-namespace:Ui.Wpf.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UpdatesViewModel}"
             Background="{StaticResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" />
        <conv:BytesToHumanConverter x:Key="BytesHuman" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="28 20 28 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="Actualizaciones disponibles" />
                    <TextBlock Margin="0 4 0 0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                <Setter Property="Text" Value="Buscando actualizaciones de controladores..." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="False">
                                        <Setter Property="Text"
                                                Value="{Binding UpdateCount, StringFormat='{}{0} actualización(es) encontrada(s) via Windows Update'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Botones de acción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Cancelar instalación -->
                    <Button Style="{StaticResource ButtonDanger}"
                            Command="{Binding CancelInstallCommand}"
                            Margin="0 0 8 0"
                            Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconX}"
                                  Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0 0 6 0" />
                            <TextBlock Text="Cancelar" />
                        </StackPanel>
                    </Button>

                    <!-- Buscar actualizaciones -->
                    <Button Style="{StaticResource ButtonSecondary}"
                            Command="{Binding CheckUpdatesCommand}"
                            Margin="0 0 8 0"
                            IsEnabled="{Binding IsInstalling, Converter={StaticResource InvertBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0 0 7 0" />
                            <TextBlock Text="Buscar" />
                        </StackPanel>
                    </Button>

                    <!-- Instalar seleccionadas -->
                    <Button Style="{StaticResource ButtonPrimary}"
                            Command="{Binding InstallSelectedCommand}"
                            IsEnabled="{Binding HasSelection}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}"
                                  Stroke="{StaticResource OnAccentBrush}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0 0 7 0" />
                            <TextBlock Text="Instalar seleccionadas" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="28 16 28 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar de selección -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14 10"
                    Margin="0 0 0 12"
                    Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource CheckBoxModern}"
                              IsChecked="{Binding AllSelected}"
                              Content="Seleccionar todas" Margin="0 0 16 0" />
                    <Button Style="{StaticResource ButtonSecondary}"
                            Padding="12 6" Command="{Binding SelectAllCommand}">
                        <TextBlock Text="Todas" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ButtonSecondary}"
                            Padding="12 6" Margin="6 0 0 0"
                            Command="{Binding SelectNoneCommand}">
                        <TextBlock Text="Ninguna" FontSize="12" />
                    </Button>
                    <TextBlock Margin="16 0 0 0" VerticalAlignment="Center"
                               Style="{StaticResource TextCaption}"
                               Text="{Binding UpdatesBadge, StringFormat='{}{0} seleccionada(s)'}"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <!-- Lista de actualizaciones -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Updates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriverInstallItem}">
                                <Border Padding="16 14"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="0 0 0 1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox / estado -->
                                        <Grid Grid.Column="0" Width="32" VerticalAlignment="Top" Margin="0 2 12 0">
                                            <!-- Checkbox (antes de instalar) -->
                                            <CheckBox Style="{StaticResource CheckBoxModern}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Visibility="{Binding IsFinished, Converter={StaticResource InvertBoolToVis}}"/>
                                            <!-- Resultado (tras instalar) -->
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                        <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Data" Value="{StaticResource IconX}" />
                                                                <Setter Property="Stroke" Value="{StaticResource ErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>

                                        <!-- Info del driver -->
                                        <StackPanel Grid.Column="1" Margin="0 0 16 0">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource TextBody}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0 3 0 0" />

                                            <!-- Progress bar (durante instalación) -->
                                            <Grid Margin="0 10 0 0"
                                                  Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ProgressBar Style="{StaticResource ProgressBarSlim}"
                                                             Height="6"
                                                             Value="{Binding Percent}"
                                                             Maximum="100" />
                                                <Grid Grid.Row="1" Margin="0 6 0 0">
                                                    <TextBlock Text="{Binding PhaseLabel}"
                                                               Style="{StaticResource TextCaption}"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Text="{Binding Percent, StringFormat='{}{0}%'}"
                                                               Style="{StaticResource TextCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Grid>
                                            </Grid>

                                            <!-- Error message (tras fallo) -->
                                            <TextBlock Margin="0 6 0 0"
                                                       Text="{Binding ErrorMessage}"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Visibility>
                                                    <Binding Path="ErrorMessage"
                                                             Converter="{StaticResource NotNullToVis}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>

                                            <!-- Éxito al finalizar -->
                                            <Border Margin="0 6 0 0"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFinished}" Value="True" />
                                                                    <Condition Binding="{Binding Success}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Actualizado correctamente"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>

                                            <!-- Reboot required -->
                                            <Border Margin="0 6 0 0"
                                                    Style="{StaticResource BadgeWarning}"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="⚠ Requiere reinicio"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Versiones -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0 2 0 0">
                                            <TextBlock Style="{StaticResource TextLabel}" Text="Versión actual" />
                                            <TextBlock Text="{Binding OldVersion}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0 2 0 0" />
                                            <Path Data="{StaticResource IconChevronDown}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.5" Width="12" Height="10"
                                                  Stretch="Uniform" HorizontalAlignment="Left"
                                                  Margin="0 2 0 2" />
                                            <TextBlock Style="{StaticResource TextLabel}" Text="Nueva versión"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding NewVersion}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular" FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold" Margin="0 2 0 0" />
                                        </StackPanel>

                                        <!-- Tamaño -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="0 2 0 0">
                                            <TextBlock Style="{StaticResource TextLabel}" Text="Tamaño" />
                                            <TextBlock Text="{Binding SizeBytes, Converter={StaticResource BytesHuman}}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0 4 0 0" />
                                        </StackPanel>

                                        <!-- Excluir: no aparecerá en futuras búsquedas (se guarda en el servicio) -->
                                        <Button Grid.Column="4" Style="{StaticResource ButtonSecondary}"
                                                VerticalAlignment="Top" Padding="8 4" FontSize="12"
                                                Content="Excluir" ToolTip="No volver a mostrar esta actualización"
                                                Visibility="{Binding IsInstalling, Converter={StaticResource InvertBoolToVis}}"
                                                Command="{Binding DataContext.ExcludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- % durante instalación -->
                                        <Border Grid.Column="4" VerticalAlignment="Top"
                                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="22" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding Percent, StringFormat='{}{0}%'}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Buscando / spinner -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBarSlim}"
                             Width="240" Margin="0 0 0 16" />
                <TextBlock Text="Consultando Windows Update..." Style="{StaticResource TextBody}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Esto puede tardar varios minutos."
                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center"
                           Margin="0 6 0 0" />
            </StackPanel>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasUpdates}" Value="False" />
                                    <Condition Binding="{Binding IsSearching}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="{StaticResource IconShield}"
                      Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.5"
                      Width="48" Height="48" Stretch="Uniform"
                      HorizontalAlignment="Center" Margin="0 0 0 16" />
                <TextBlock Text="Todo al día" Style="{StaticResource TextTitle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="No se encontraron actualizaciones de controladores."
                           Style="{StaticResource TextBody}" HorizontalAlignment="Center"
                           Margin="0 6 0 0" />
                <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Center"
                        Margin="0 20 0 0" Command="{Binding CheckUpdatesCommand}">
                    <TextBlock Text="Volver a buscar" />
                </Button>
            </StackPanel>

        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Padding="28 10"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0 1 0 0"
                Visibility="{Binding GlobalStatus, Converter={StaticResource NotNullToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningDimBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding GlobalStatus}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Mini progress global -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="12" Margin="0 0 12 0"
                               Foreground="{StaticResource AccentBrush}">
                        <Run Text="{Binding CompletedInstalls}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalToInstall}" />
                    </TextBlock>
                    <ProgressBar Width="120" Height="4"
                                 Style="{StaticResource ProgressBarSlim}"
                                 Maximum="{Binding TotalToInstall}"
                                 Value="{Binding CompletedInstalls}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
