<Window x:Class="Ui.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ui.Wpf.ViewModels"
        xmlns:conv="clr-namespace:Ui.Wpf.Converters"
        xmlns:views="clr-namespace:Ui.Wpf.Views"
        mc:Ignorable="d"
        Title="DriverUpdater"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:PageEqualityConverter x:Key="PageEq" />

        <!-- Routing automático de ViewModel a Vista -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <!-- Borde exterior: esquinas redondeadas -->
    <Border CornerRadius="12"
            Background="{StaticResource BgBaseBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════
                 SIDEBAR
                 ══════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgDeepBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0 0 1 0">
                <DockPanel>

                    <!-- Logo + título -->
                    <StackPanel DockPanel.Dock="Top" Margin="20 24 20 16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{StaticResource AccentBrush}">
                                <Path Data="{StaticResource IconDriver}"
                                      Stroke="White" StrokeThickness="1.5"
                                      Width="18" Height="18"
                                      Stretch="Uniform" />
                            </Border>
                            <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="Driver" /><Run Text="Updater"
                                         Foreground="{StaticResource AccentBrush}" />
                                </TextBlock>
                                <TextBlock Text="Versión 1.0"
                                           FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Pill de estado de conexión -->
                        <Border Margin="0 12 0 0" Padding="10 6" CornerRadius="20"
                                Background="{StaticResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="ConnLed" Width="7" Height="7" Margin="0 0 7 0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Desconectado" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                    <Setter Property="Text" Value="Conectando…" />
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Text" Value="Servicio activo" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Alerta reinicio pendiente -->
                    <Border DockPanel.Dock="Top" Margin="12 0 12 4"
                            Padding="10 8" CornerRadius="8"
                            Background="{StaticResource WarningDimBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1"
                            Visibility="{Binding PendingReboot, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWarning}"
                                      Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0 0 6 0" />
                                <TextBlock Text="Reinicio pendiente"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Reinicia el equipo para activar los nuevos controladores."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" TextWrapping="Wrap" Margin="0 3 0 0" />
                        </StackPanel>
                    </Border>

                    <!-- Divisor -->
                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="16 4 16 8" />

                    <!-- Items de navegación -->
                    <StackPanel DockPanel.Dock="Top" Margin="8 0">

                        <views:NavItem Label="Inicio"
                                       IconData="{StaticResource IconDashboard}"
                                       BadgeCount="0"
                                       Command="{Binding NavigateCommand}"
                                       CommandParameter="{x:Static vm:AppPage.Dashboard}">
                            <views:NavItem.IsActive>
                                <Binding Path="ActivePage" Converter="{StaticResource PageEq}"
                                         ConverterParameter="{x:Static vm:AppPage.Dashboard}" />
                            </views:NavItem.IsActive>
                        </views:NavItem>

                        <views:NavItem Label="Actualizaciones"
                                       IconData="{StaticResource IconUpdates}"
                                       BadgeCount="{Binding UpdatesBadge}"
                                       Command="{Binding NavigateCommand}"
                                       CommandParameter="{x:Static vm:AppPage.Updates}">
                            <views:NavItem.IsActive>
                                <Binding Path="ActivePage" Converter="{StaticResource PageEq}"
                                         ConverterParameter="{x:Static vm:AppPage.Updates}" />
                            </views:NavItem.IsActive>
                        </views:NavItem>

                        <views:NavItem Label="Historial"
                                       IconData="{StaticResource IconHistory}"
                                       BadgeCount="0"
                                       Command="{Binding NavigateCommand}"
                                       CommandParameter="{x:Static vm:AppPage.History}">
                            <views:NavItem.IsActive>
                                <Binding Path="ActivePage" Converter="{StaticResource PageEq}"
                                         ConverterParameter="{x:Static vm:AppPage.History}" />
                            </views:NavItem.IsActive>
                        </views:NavItem>

                        <views:NavItem Label="Ajustes"
                                       IconData="{StaticResource IconSettings}"
                                       BadgeCount="0"
                                       Command="{Binding NavigateCommand}"
                                       CommandParameter="{x:Static vm:AppPage.Settings}">
                            <views:NavItem.IsActive>
                                <Binding Path="ActivePage" Converter="{StaticResource PageEq}"
                                         ConverterParameter="{x:Static vm:AppPage.Settings}" />
                            </views:NavItem.IsActive>
                        </views:NavItem>

                    </StackPanel>

                    <!-- Expansor -->
                    <Grid DockPanel.Dock="Top" />

                    <!-- Pie de sidebar -->
                    <Border DockPanel.Dock="Bottom" Padding="20 12"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0 1 0 0">
                        <TextBlock Style="{StaticResource TextCaption}"
                                   Text="Seguro · Sin privilegios en UI" />
                    </Border>

                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════════════════
                 ÁREA DE CONTENIDO
                 ══════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra de título con drag -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgDeepBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0 0 0 1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Breadcrumb -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DriverUpdater" FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text=" › " FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock x:Name="PageBreadcrumb" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Inicio" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActivePage}"
                                                         Value="{x:Static vm:AppPage.Updates}">
                                                <Setter Property="Text" Value="Actualizaciones" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActivePage}"
                                                         Value="{x:Static vm:AppPage.History}">
                                                <Setter Property="Text" Value="Historial" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActivePage}"
                                                         Value="{x:Static vm:AppPage.Settings}">
                                                <Setter Property="Text" Value="Ajustes" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Window controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ButtonIcon}" Click="BtnMinimize_Click">
                                <Path Data="M 4,10 L 16,10"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Width="13" Height="10" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource ButtonIcon}" Click="BtnMaximize_Click">
                                <Path Data="M 5,5 L 15,5 L 15,15 L 5,15 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      Fill="Transparent"
                                      StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                            <Button Click="BtnClose_Click" Margin="2 0 0 0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="6" Padding="8"
                                                Background="Transparent">
                                            <Path Data="M 5,5 L 15,15 M 15,5 L 5,15"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="1.5"
                                                  Width="12" Height="12" Stretch="Uniform" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"
                                                        Value="{StaticResource ErrorBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido de la página -->
                <Grid Grid.Row="1">
                    <!-- Página activa (sólo cuando conectado) -->
                    <ContentPresenter Content="{Binding CurrentPage}"
                                      Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />

                    <!-- Pantalla de desconexión -->
                    <Grid Visibility="{Binding IsConnected, Converter={StaticResource InvertBoolToVis}}"
                          Background="{StaticResource BgBaseBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                            <Border Width="80" Height="80" CornerRadius="20"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BgElevatedBrush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                    BorderThickness="1" Margin="0 0 0 28">
                                <Path Data="{StaticResource IconDisconnected}"
                                      Stroke="{StaticResource TextTertiaryBrush}"
                                      StrokeThickness="1.5"
                                      Width="36" Height="36" Stretch="Uniform" />
                            </Border>
                            <TextBlock Style="{StaticResource TextHeading}"
                                       Text="Servicio no disponible"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0 10 0 0" TextAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource TextBody}" LineHeight="22">
                                El servicio de Windows DriverUpdater no está en ejecución.
                                Asegúrate de que está instalado y activo, o inicia sesión
                                como administrador para arrancarlo.
                            </TextBlock>
                            <Button Margin="0 28 0 0"
                                    Style="{StaticResource ButtonPrimary}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding RetryConnectionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}"
                                          Stroke="White" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform"
                                          Margin="0 0 8 0" />
                                    <TextBlock Text="Reintentar conexión" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
