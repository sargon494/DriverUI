<UserControl x:Class="Ui.Wpf.Views.NavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ui.Wpf.Converters"
             x:Name="Self">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
    </UserControl.Resources>

    <Button Command="{Binding ElementName=Self, Path=Command}"
            CommandParameter="{Binding ElementName=Self, Path=CommandParameter}"
            Margin="0 2"
            Cursor="Hand"
            ToolTip="{Binding ElementName=Self, Path=Label}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Root"
                        CornerRadius="8"
                        Padding="12 10"
                        Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icono -->
                        <Path Grid.Column="0"
                              x:Name="Icon"
                              Data="{Binding ElementName=Self, Path=IconData}"
                              Stroke="{StaticResource TextTertiaryBrush}"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Margin="0 0 10 0" />

                        <!-- Label -->
                        <TextBlock Grid.Column="1"
                                   x:Name="Label"
                                   Text="{Binding ElementName=Self, Path=Label}"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Badge -->
                        <Border Grid.Column="2"
                                x:Name="Badge"
                                MinWidth="20" Height="20"
                                CornerRadius="10"
                                Padding="5 0"
                                Background="{StaticResource AccentBrush}"
                                Visibility="{Binding ElementName=Self, Path=BadgeCount,
                                             Converter={StaticResource CountToVis}}">
                            <TextBlock x:Name="BadgeText"
                                       Text="{Binding ElementName=Self, Path=BadgeCount}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <!-- Activo -->
                    <DataTrigger Binding="{Binding ElementName=Self, Path=IsActive}" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDimBrush}" />
                        <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <!-- Hover -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{StaticResource BgElevatedBrush}" />
                        <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource AccentHoverBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
