<UserControl x:Class="Ui.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ui.Wpf.ViewModels"
             xmlns:conv="clr-namespace:Ui.Wpf.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             Background="{StaticResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" />
        <conv:TimestampToStringConverter x:Key="TsToStr" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="28 20 28 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="Historial de operaciones" />
                    <TextBlock Style="{StaticResource TextBody}" Margin="0 4 0 0"
                               Text="Registro persistente de todas las instalaciones y rollbacks." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonDanger}"
                            Command="{Binding RollbackCommand}"
                            IsEnabled="{Binding CanRollback}"
                            Margin="0 0 8 0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRollback}"
                                  Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0 0 6 0" />
                            <TextBlock Text="Deshacer seleccionada" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding LoadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0 0 6 0" />
                            <TextBlock Text="Actualizar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="28 16 28 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Buscador + rollback result -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="12 8" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconScan}"
                              Stroke="{StaticResource TextTertiaryBrush}"
                              StrokeThickness="1.5" Width="14" Height="14"
                              Stretch="Uniform" Margin="0 0 8 0" />
                        <TextBox Style="{StaticResource TextBoxModern}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 Width="280" Foreground="{StaticResource TextPrimaryBrush}">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="0" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="Filtrar historial..." Margin="4 0 0 0"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding FilterText, Converter={StaticResource InvertBoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Rollback result pill -->
                <Border Grid.Column="1" Margin="12 0 0 0" Padding="12 8" CornerRadius="8"
                        Visibility="{Binding RollbackResult, Converter={StaticResource NotNullToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessDimBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RollbackSuccess}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource ErrorDimBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding RollbackResult}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RollbackSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Tabla -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera -->
                    <Border Grid.Row="0" Padding="16 10"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0 0 0 1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TextLabel}" Text="FECHA" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TextLabel}" Text="DISPOSITIVO" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TextLabel}" Text="VERSIÓN ANTERIOR" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TextLabel}" Text="VERSIÓN NUEVA" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TextLabel}" Text="OPERACIÓN" />
                            <TextBlock Grid.Column="5" Style="{StaticResource TextLabel}" Text="RESULTADO"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Spinner -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBarSlim}"
                                     Width="200" Margin="0 0 0 12" />
                        <TextBlock Text="Cargando historial..." Style="{StaticResource TextBody}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Filas -->
                    <ListBox Grid.Row="1"
                             Style="{StaticResource ListBoxClean}"
                             ItemContainerStyle="{StaticResource ListBoxItemClean}"
                             ItemsSource="{Binding Filtered}"
                             SelectedItem="{Binding SelectedEntry}"
                             Visibility="{Binding IsLoading, Converter={StaticResource InvertBoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16 12"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="0 0 0 1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Fecha -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, Converter={StaticResource TsToStr}}"
                                                   FontFamily="Consolas, Courier New" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Dispositivo -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DriverTitle}"
                                                       Style="{StaticResource TextCaption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0 2 0 0" />
                                        </StackPanel>

                                        <!-- Versión anterior -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PreviousVersion}"
                                                   FontFamily="Consolas, Courier New" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Versión nueva -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding NewVersion}"
                                                   FontFamily="Consolas, Courier New" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <!-- Tipo operación -->
                                        <Border Grid.Column="4" VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Padding="8 3" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource InfoDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OperationType}" Value="Rollback">
                                                            <Setter Property="Background" Value="{StaticResource WarningDimBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding OperationType}"
                                                       FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OperationType}" Value="Rollback">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Resultado -->
                                        <Path Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="18" Height="18" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                    <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Data" Value="{StaticResource IconX}" />
                                                            <Setter Property="Stroke" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Filtered.Count}" Value="0" />
                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconHistory}"
                              Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.5"
                              Width="40" Height="40" Stretch="Uniform"
                              HorizontalAlignment="Center" Margin="0 0 0 12" />
                        <TextBlock Text="Sin registros" Style="{StaticResource TextTitle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="El historial aparecerá aquí después de la primera instalación."
                                   Style="{StaticResource TextBody}" HorizontalAlignment="Center"
                                   Margin="0 6 0 0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Spinner de rollback -->
        <Border Grid.Row="2" Padding="28 8"
                Background="{StaticResource WarningDimBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="0 1 0 0"
                Visibility="{Binding IsRollingBack, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBarSlim}"
                             Width="120" Margin="0 0 12 0" />
                <TextBlock Text="Deshaciendo instalación..." Style="{StaticResource TextBody}"
                           Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
