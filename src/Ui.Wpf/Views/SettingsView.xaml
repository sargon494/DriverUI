<UserControl x:Class="Ui.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ui.Wpf.ViewModels"
             xmlns:conv="clr-namespace:Ui.Wpf.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="{StaticResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28 20 28 32" MaxWidth="700" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Style="{StaticResource TextHeading}" Text="Ajustes" />
            <TextBlock Style="{StaticResource TextBody}" Margin="0 6 0 28"
                       Text="Configura el comportamiento del servicio DriverUpdater." />

            <!-- ══ Comprobación automática ══ -->
            <Border Style="{StaticResource Card}" Margin="0 0 0 16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{StaticResource AccentDimBrush}">
                            <Path Data="{StaticResource IconBell}"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                            <TextBlock Text="Comprobación automática"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="El servicio buscará actualizaciones periódicamente."
                                       Style="{StaticResource TextCaption}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Style="{StaticResource CheckBoxModern}"
                              IsChecked="{Binding AutoCheckEnabled}"
                              Content="Activar comprobación automática" />

                    <StackPanel Orientation="Horizontal" Margin="0 16 0 0"
                                IsEnabled="{Binding AutoCheckEnabled}">
                        <TextBlock Text="Intervalo:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0 0 12 0" />
                        <Border Style="{StaticResource Card}" Padding="12 8" CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ButtonIcon}" Width="28" Height="28"
                                        Click="DecrementInterval_Click">
                                    <TextBlock Text="−" FontSize="16"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>
                                <TextBlock Text="{Binding CheckIntervalDays}"
                                           Width="30" TextAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource ButtonIcon}" Width="28" Height="28"
                                        Click="IncrementInterval_Click">
                                    <TextBlock Text="+" FontSize="16"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="día(s)" VerticalAlignment="Center" Margin="10 0 0 0"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ Seguridad ══ -->
            <Border Style="{StaticResource Card}" Margin="0 0 0 16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{StaticResource SuccessDimBrush}">
                            <Path Data="{StaticResource IconShield}"
                                  Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.5"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                            <TextBlock Text="Seguridad de controladores"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Controla qué firmas digitales se aceptan."
                                       Style="{StaticResource TextCaption}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Style="{StaticResource CheckBoxModern}"
                              IsChecked="{Binding OnlyWhql}"
                              Content="Solo controladores WHQL certificados por Microsoft (recomendado)" />

                    <Border Margin="0 12 0 0" Padding="12 10" CornerRadius="8"
                            Background="{StaticResource InfoDimBrush}"
                            BorderBrush="{StaticResource InfoBrush}" BorderThickness="1"
                            Visibility="{Binding OnlyWhql, Converter={StaticResource InvertBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWarning}"
                                  Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0 0 8 0" />
                            <TextBlock TextWrapping="Wrap" MaxWidth="500"
                                       Foreground="{StaticResource WarningBrush}" FontSize="12">
                                Modo avanzado: se aceptan controladores con firma válida no-WHQL.
                                Solo para usuarios expertos. Puede reducir la estabilidad del sistema.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ Exclusiones ══ -->
            <Border Style="{StaticResource Card}" Margin="0 0 0 16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{StaticResource WarningDimBrush}">
                            <Path Data="{StaticResource IconFilter}"
                                  Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                            <TextBlock Text="Exclusiones"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Hardware IDs de dispositivos que no se actualizarán."
                                       Style="{StaticResource TextCaption}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Añadir exclusión -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                        <TextBox Style="{StaticResource TextBoxModern}"
                                 Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}"
                                 Width="340"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 ToolTip="Introduce un Hardware ID (ej. PCI\VEN_8086...)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddExclusionCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource ButtonPrimary}"
                                Margin="8 0 0 0" Padding="16 8"
                                Command="{Binding AddExclusionCommand}">
                            <TextBlock Text="Añadir" />
                        </Button>
                    </StackPanel>

                    <!-- Lista exclusiones -->
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12 8" Margin="0 3"
                                        Background="{StaticResource BgElevatedBrush}"
                                        CornerRadius="6"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas, Courier New" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ButtonIcon}"
                                                Command="{Binding DataContext.RemoveExclusionCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconX}"
                                                  Stroke="{StaticResource TextTertiaryBrush}"
                                                  StrokeThickness="1.5"
                                                  Width="10" Height="10" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty -->
                    <TextBlock Margin="0 8 0 0"
                               Text="Sin exclusiones configuradas.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Exclusions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══ Botones guardar ══ -->
            <Grid Margin="0 8 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}"
                              Stroke="White" StrokeThickness="1.5"
                              Width="13" Height="13" Stretch="Uniform" Margin="0 0 7 0" />
                        <TextBlock Text="Guardar ajustes" />
                    </StackPanel>
                </Button>

                <!-- Saved feedback -->
                <Border Grid.Column="1" Margin="12 0 0 0" Padding="12 8" CornerRadius="8"
                        Background="{StaticResource SuccessDimBrush}"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="✓ Guardado" Foreground="{StaticResource SuccessBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                </Border>

                <!-- Error -->
                <Border Grid.Column="1" Margin="12 0 0 0" Padding="12 8" CornerRadius="8"
                        Background="{StaticResource ErrorDimBrush}"
                        BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding SaveError, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="{Binding SaveError}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="12" />
                </Border>

                <!-- Reset -->
                <Button Grid.Column="3" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding ResetDefaultsCommand}">
                    <TextBlock Text="Restaurar predeterminados" />
                </Button>
            </Grid>

            <!-- Nota Sprint 5 -->
            <Border Margin="0 24 0 0" Padding="14 10" CornerRadius="8"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconInfo}"
                          Stroke="{StaticResource InfoBrush}" StrokeThickness="1.5"
                          Width="14" Height="14" Stretch="Uniform" Margin="0 0 8 0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="11">
                        Los ajustes se persistirán en %ProgramData%\DriverUpdater\config.json
                        mediante los RPCs GetSettings/UpdateSettings (Sprint 6).
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
