<UserControl x:Class="Ui.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ui.Wpf.ViewModels"
             xmlns:conv="clr-namespace:Ui.Wpf.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             Background="{StaticResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" />
        <conv:DriverStatusToBrushConverter x:Key="StatusToBrush" />
        <conv:DriverStatusToLabelConverter x:Key="StatusToLabel" />
        <conv:TimestampToStringConverter x:Key="TsToStr" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="28 20 28 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="Inventario de controladores" />
                    <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                        <TextBlock Style="{StaticResource TextBody}"
                                   Text="{Binding TotalDrivers, StringFormat='{}{0} controladores detectados'}" />
                        <TextBlock Style="{StaticResource TextBody}" Margin="12 0 0 0"
                                   Text="{Binding LastScan, StringFormat='Último escaneo: {0}'}"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding ScanCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconScan}"
                              Stroke="White" StrokeThickness="1.5"
                              Width="14" Height="14" Stretch="Uniform" Margin="0 0 8 0" />
                        <TextBlock Text="Escanear" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="28 16 28 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Stat cards ── -->
            <UniformGrid Grid.Row="0" Columns="4" HorizontalAlignment="Stretch">

                <!-- Total -->
                <Border Style="{StaticResource CardCompact}" Margin="0 0 8 0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextLabel}" Text="Total" />
                        <TextBlock Style="{StaticResource TextDisplay}" Margin="0 4 0 0"
                                   Text="{Binding TotalDrivers}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Controladores" Margin="0 2 0 0" />
                    </StackPanel>
                </Border>

                <!-- OK -->
                <Border Style="{StaticResource CardCompact}" Margin="4 0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextLabel}" Text="En orden"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Style="{StaticResource TextDisplay}" Margin="0 4 0 0"
                                   Text="{Binding OkDrivers}"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Funcionando correctamente"
                                   Margin="0 2 0 0" />
                    </StackPanel>
                </Border>

                <!-- Error -->
                <Border Style="{StaticResource CardCompact}" Margin="4 0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextLabel}" Text="Con errores"
                                   Foreground="{StaticResource ErrorBrush}" />
                        <TextBlock Style="{StaticResource TextDisplay}" Margin="0 4 0 0"
                                   Text="{Binding ErrorDrivers}"
                                   Foreground="{StaticResource ErrorBrush}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Requieren atención"
                                   Margin="0 2 0 0" />
                    </StackPanel>
                </Border>

                <!-- Degradado -->
                <Border Style="{StaticResource CardCompact}" Margin="8 0 0 0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextLabel}" Text="Degradados"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Style="{StaticResource TextDisplay}" Margin="0 4 0 0"
                                   Text="{Binding DegradedDrivers}"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Funcionamiento reducido"
                                   Margin="0 2 0 0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Barra de búsqueda + estado ── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Búsqueda -->
                <Border Style="{StaticResource Card}" Padding="12 8" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconScan}"
                              Stroke="{StaticResource TextTertiaryBrush}"
                              StrokeThickness="1.5" Width="14" Height="14"
                              Stretch="Uniform" Margin="0 0 8 0" />
                        <TextBox Style="{StaticResource TextBoxModern}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="0"
                                 Width="280"
                                 Foreground="{StaticResource TextPrimaryBrush}">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="0" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="Buscar controladores..." Margin="4 0 0 0"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource InvertBoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Pill salud del sistema -->
                <Border Grid.Column="1" Margin="12 0 0 0"
                        Padding="16 10" CornerRadius="8"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessDimBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource WarningDimBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" Margin="0 0 7 0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                    <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                            <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                            <Setter Property="Stroke" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding HealthSummary}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Error message ── -->
            <Border Grid.Row="2" VerticalAlignment="Bottom" Margin="0 52 0 0"
                    Style="{StaticResource BadgeError}" Padding="12 6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}" FontSize="12" />
            </Border>

            <!-- ── Lista de drivers ── -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera tabla -->
                    <Border Grid.Row="0" Padding="16 10"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0 0 0 1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TextLabel}" Text="Dispositivo" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TextLabel}" Text="Fabricante" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TextLabel}" Text="Versión" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TextLabel}" Text="Clase" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TextLabel}" Text="Estado"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Spinner de carga -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True"
                                     Style="{StaticResource ProgressBarSlim}"
                                     Width="200" Margin="0 0 0 12" />
                        <TextBlock Text="Escaneando controladores..." Style="{StaticResource TextBody}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasDrivers}" Value="False" />
                                            <Condition Binding="{Binding IsScanning}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconDriver}"
                              Stroke="{StaticResource TextTertiaryBrush}"
                              StrokeThickness="1.5" Width="40" Height="40"
                              Stretch="Uniform" Margin="0 0 0 12"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Sin resultados" Style="{StaticResource TextTitle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Pulsa 'Escanear' para detectar los controladores instalados."
                                   Style="{StaticResource TextBody}" HorizontalAlignment="Center"
                                   Margin="0 4 0 0" />
                    </StackPanel>

                    <!-- Filas -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasDrivers}" Value="True" />
                                            <Condition Binding="{Binding IsScanning}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding FilteredDrivers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16 10"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="0 0 0 1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DeviceName}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding InfName}"
                                                           Style="{StaticResource TextCaption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0 2 0 0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Manufacturer}"
                                                       Style="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DriverVersion}"
                                                       Style="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI" Typography.NumeralAlignment="Tabular"
                                                       FontSize="11" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding DeviceClass}"
                                                       Style="{StaticResource TextCaption}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- Status badge -->
                                            <Border Grid.Column="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="8 4" CornerRadius="4"
                                                    BorderThickness="1">
                                                <Border.BorderBrush>
                                                    <Binding Path="Status"
                                                             Converter="{StaticResource StatusToBrush}" />
                                                </Border.BorderBrush>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                                                           FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <Binding Path="Status"
                                                                 Converter="{StaticResource StatusToBrush}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
