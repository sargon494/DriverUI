<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         PALETA OSCURA PREMIUM
         ═══════════════════════════════════════════════════════ -->

    <!-- Fondos -->
    <Color x:Key="BgDeepColor">#111113</Color>
    <Color x:Key="BgBaseColor">#18181B</Color>
    <Color x:Key="BgSurfaceColor">#1F1F23</Color>
    <Color x:Key="BgElevatedColor">#27272D</Color>
    <Color x:Key="BgCardColor">#1F1F23</Color>
    <Color x:Key="BgHoverColor">#303038</Color>

    <!-- Acento principal: Indigo vibrante -->
    <Color x:Key="AccentColor">#2DD4BF</Color>
    <Color x:Key="AccentHoverColor">#5EEAD4</Color>
    <Color x:Key="AccentPressedColor">#14B8A6</Color>
    <Color x:Key="AccentGlowColor">#0F766E</Color>
    <Color x:Key="AccentDimColor">#123B37</Color>

    <!-- Texto sobre acento (contraste con el fondo teal claro) -->
    <Color x:Key="OnAccentColor">#04201C</Color>

    <!-- Estados semánticos -->
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessDimColor">#0F2E24</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningDimColor">#3A2E0E</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="ErrorDimColor">#3B1616</Color>
    <Color x:Key="InfoColor">#60A5FA</Color>
    <Color x:Key="InfoDimColor">#172A45</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#F4F4F5</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="TextTertiaryColor">#71717A</Color>
    <Color x:Key="TextDisabledColor">#3F3F46</Color>

    <!-- Bordes -->
    <Color x:Key="BorderSubtleColor">#27272D</Color>
    <Color x:Key="BorderDefaultColor">#3A3A42</Color>
    <Color x:Key="BorderAccentColor">#0F766E</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgDeepBrush"     Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgBaseBrush"     Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush"  Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgCardBrush"     Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgHoverBrush"    Color="{StaticResource BgHoverColor}" />

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentDimBrush"     Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="OnAccentBrush"     Color="{StaticResource OnAccentColor}" />

    <SolidColorBrush x:Key="SuccessBrush"    Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessDimBrush" Color="{StaticResource SuccessDimColor}" />
    <SolidColorBrush x:Key="WarningBrush"    Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningDimBrush" Color="{StaticResource WarningDimColor}" />
    <SolidColorBrush x:Key="ErrorBrush"      Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorDimBrush"   Color="{StaticResource ErrorDimColor}" />
    <SolidColorBrush x:Key="InfoBrush"       Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoDimBrush"    Color="{StaticResource InfoDimColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush"  Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="BorderAccentBrush"  Color="{StaticResource BorderAccentColor}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4BF" Offset="0" />
        <GradientStop Color="#14B8A6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#0F766E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavSidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111113" Offset="0" />
        <GradientStop Color="#111113" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGlowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F1F23" Offset="0" />
        <GradientStop Color="#1F1F23" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography Sizes (used as Double resources) -->
    <system:Double x:Key="FontSizeXS"   xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>
    <system:Double x:Key="FontSizeSM"   xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="FontSizeMD"   xmlns:system="clr-namespace:System;assembly=mscorlib">13</system:Double>
    <system:Double x:Key="FontSizeLG"   xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="FontSizeXL"   xmlns:system="clr-namespace:System;assembly=mscorlib">18</system:Double>
    <system:Double x:Key="FontSize2XL"  xmlns:system="clr-namespace:System;assembly=mscorlib">24</system:Double>
    <system:Double x:Key="FontSize3XL"  xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>

</ResourceDictionary>
