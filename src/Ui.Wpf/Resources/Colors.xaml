<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         PALETA OSCURA PREMIUM
         ═══════════════════════════════════════════════════════ -->

    <!-- Fondos -->
    <Color x:Key="BgDeepColor">#0A0D14</Color>
    <Color x:Key="BgBaseColor">#0F1219</Color>
    <Color x:Key="BgSurfaceColor">#161B27</Color>
    <Color x:Key="BgElevatedColor">#1C2333</Color>
    <Color x:Key="BgCardColor">#202840</Color>
    <Color x:Key="BgHoverColor">#2A3352</Color>

    <!-- Acento principal: Indigo vibrante -->
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#818CF8</Color>
    <Color x:Key="AccentPressedColor">#4F46E5</Color>
    <Color x:Key="AccentGlowColor">#3730A3</Color>
    <Color x:Key="AccentDimColor">#312E81</Color>

    <!-- Estados semánticos -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessDimColor">#064E3B</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningDimColor">#451A03</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorDimColor">#450A0A</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoDimColor">#1E3A5F</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextTertiaryColor">#64748B</Color>
    <Color x:Key="TextDisabledColor">#334155</Color>

    <!-- Bordes -->
    <Color x:Key="BorderSubtleColor">#1E2D4A</Color>
    <Color x:Key="BorderDefaultColor">#2D3F5E</Color>
    <Color x:Key="BorderAccentColor">#4338CA</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgDeepBrush"     Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgBaseBrush"     Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush"  Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgCardBrush"     Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgHoverBrush"    Color="{StaticResource BgHoverColor}" />

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentDimBrush"     Color="{StaticResource AccentDimColor}" />

    <SolidColorBrush x:Key="SuccessBrush"    Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessDimBrush" Color="{StaticResource SuccessDimColor}" />
    <SolidColorBrush x:Key="WarningBrush"    Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningDimBrush" Color="{StaticResource WarningDimColor}" />
    <SolidColorBrush x:Key="ErrorBrush"      Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorDimBrush"   Color="{StaticResource ErrorDimColor}" />
    <SolidColorBrush x:Key="InfoBrush"       Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoDimBrush"    Color="{StaticResource InfoDimColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush"  Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="BorderAccentBrush"  Color="{StaticResource BorderAccentColor}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavSidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D1220" Offset="0" />
        <GradientStop Color="#0A0F1A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGlowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E2A45" Offset="0" />
        <GradientStop Color="#141C30" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography Sizes (used as Double resources) -->
    <system:Double x:Key="FontSizeXS"   xmlns:system="clr-namespace:System;assembly=mscorlib">10</system:Double>
    <system:Double x:Key="FontSizeSM"   xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="FontSizeMD"   xmlns:system="clr-namespace:System;assembly=mscorlib">13</system:Double>
    <system:Double x:Key="FontSizeLG"   xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="FontSizeXL"   xmlns:system="clr-namespace:System;assembly=mscorlib">18</system:Double>
    <system:Double x:Key="FontSize2XL"  xmlns:system="clr-namespace:System;assembly=mscorlib">22</system:Double>
    <system:Double x:Key="FontSize3XL"  xmlns:system="clr-namespace:System;assembly=mscorlib">28</system:Double>

</ResourceDictionary>
