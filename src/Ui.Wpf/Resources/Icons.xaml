<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         ICON PATHS — Segoe Fluent Icons / Heroicons style
         Todos los paths están en viewport 20x20
         ═══════════════════════════════════════════════════════ -->

    <!-- Dashboard / Home -->
    <Geometry x:Key="IconDashboard">
        M 3,9.5 L 10,3 L 17,9.5 L 17,17 L 13,17 L 13,13 L 7,13 L 7,17 L 3,17 Z
    </Geometry>

    <!-- Updates / Arrow up -->
    <Geometry x:Key="IconUpdates">
        M 10,3 L 10,14 M 5,8 L 10,3 L 15,8 M 3,17 L 17,17
    </Geometry>

    <!-- History / Clock -->
    <Geometry x:Key="IconHistory">
        M 10,3 A 7,7 0 1 1 3,10 M 10,3 L 10,10 L 14,13
    </Geometry>

    <!-- Settings / Gear -->
    <Geometry x:Key="IconSettings">
        M 10,7 A 3,3 0 1 0 10,13 A 3,3 0 1 0 10,7 Z
        M 10,2 L 10,4.5
        M 10,15.5 L 10,18
        M 2,10 L 4.5,10
        M 15.5,10 L 18,10
        M 4.1,4.1 L 5.9,5.9
        M 14.1,14.1 L 15.9,15.9
        M 15.9,4.1 L 14.1,5.9
        M 5.9,14.1 L 4.1,15.9
    </Geometry>

    <!-- Check / Success -->
    <Geometry x:Key="IconCheck">M 3,10 L 8,15 L 17,5</Geometry>

    <!-- X / Error -->
    <Geometry x:Key="IconX">M 4,4 L 16,16 M 16,4 L 4,16</Geometry>

    <!-- Warning / Triangle -->
    <Geometry x:Key="IconWarning">
        M 10,3 L 18,17 L 2,17 Z M 10,9 L 10,13 M 10,15 L 10,15.5
    </Geometry>

    <!-- Info / Circle-i -->
    <Geometry x:Key="IconInfo">
        M 10,3 A 7,7 0 1 0 10,17 A 7,7 0 1 0 10,3 Z
        M 10,9 L 10,9.2
        M 10,11 L 10,15
    </Geometry>

    <!-- Refresh / Arrows -->
    <Geometry x:Key="IconRefresh">
        M 16,10 A 6,6 0 1 1 13.7,5.2
        M 14,3 L 14,6 L 17,6
    </Geometry>

    <!-- Download -->
    <Geometry x:Key="IconDownload">
        M 10,3 L 10,13 M 5,9 L 10,14 L 15,9 M 3,17 L 17,17
    </Geometry>

    <!-- Install / Box-check -->
    <Geometry x:Key="IconInstall">
        M 4,6 L 4,17 L 16,17 L 16,6 M 2,6 L 18,6 M 8,3 L 12,3 L 12,6 L 8,6 Z
        M 7,12 L 9,14 L 13,10
    </Geometry>

    <!-- Rollback / Undo -->
    <Geometry x:Key="IconRollback">
        M 4,9 L 4,4 L 9,4
        M 4,4 A 8,8 0 1 1 3.5,10.5
    </Geometry>

    <!-- Scan / Magnifier -->
    <Geometry x:Key="IconScan">
        M 8,3 A 5,5 0 1 0 8,13 A 5,5 0 1 0 8,3 Z
        M 12,12 L 17,17
    </Geometry>

    <!-- Driver / Chip -->
    <Geometry x:Key="IconDriver">
        M 5,5 L 15,5 L 15,15 L 5,15 Z
        M 8,2 L 8,5 M 12,2 L 12,5
        M 8,15 L 8,18 M 12,15 L 12,18
        M 2,8 L 5,8 M 2,12 L 5,12
        M 15,8 L 18,8 M 15,12 L 18,12
        M 8,8 L 12,8 L 12,12 L 8,12 Z
    </Geometry>

    <!-- Connected / Network -->
    <Geometry x:Key="IconConnected">
        M 10,10 A 2,2 0 1 0 10,14 A 2,2 0 1 0 10,10 Z
        M 6,7 A 5.6,5.6 0 0 1 14,7
        M 3,4 A 9.5,9.5 0 0 1 17,4
        M 10,12 L 10,12
    </Geometry>

    <!-- Disconnected / Network-off -->
    <Geometry x:Key="IconDisconnected">
        M 3,3 L 17,17
        M 10,10 A 2,2 0 1 0 10,14 A 2,2 0 1 0 10,10 Z
        M 6,7 A 5.6,5.6 0 0 1 10.5,5.2
        M 3,4 A 9.5,9.5 0 0 1 7.5,2.2
    </Geometry>

    <!-- Shield / Security -->
    <Geometry x:Key="IconShield">
        M 10,2 L 17,5 L 17,10 C 17,14 14,17 10,18 C 6,17 3,14 3,10 L 3,5 Z
        M 7,10 L 9,12 L 13,8
    </Geometry>

    <!-- Restore Point / Time-back -->
    <Geometry x:Key="IconRestorePoint">
        M 10,3 A 7,7 0 1 0 17,10
        M 10,6 L 10,10 L 13,13
        M 13,3 L 17,3 L 17,7
        M 17,3 A 7,7 0 0 1 17,10
    </Geometry>

    <!-- Bell / Notification -->
    <Geometry x:Key="IconBell">
        M 10,2 C 7,2 5,5 5,8 L 5,13 L 3,15 L 17,15 L 15,13 L 15,8 C 15,5 13,2 10,2 Z
        M 8,15 A 2,2 0 0 0 12,15
    </Geometry>

    <!-- External link -->
    <Geometry x:Key="IconExternalLink">
        M 11,3 L 17,3 L 17,9
        M 17,3 L 9,11
        M 7,5 L 4,5 C 3,5 3,6 3,6 L 3,16 C 3,17 4,17 4,17 L 14,17 C 15,17 15,16 15,16 L 15,13
    </Geometry>

    <!-- ChevronRight -->
    <Geometry x:Key="IconChevronRight">M 7,5 L 13,10 L 7,15</Geometry>

    <!-- ChevronDown -->
    <Geometry x:Key="IconChevronDown">M 5,7 L 10,13 L 15,7</Geometry>

    <!-- Menu / Hamburger -->
    <Geometry x:Key="IconMenu">M 3,6 L 17,6 M 3,10 L 17,10 M 3,14 L 17,14</Geometry>

    <!-- Ellipsis (more) -->
    <Geometry x:Key="IconMore">
        M 5,10 A 1,1 0 1 0 5,10.1
        M 10,10 A 1,1 0 1 0 10,10.1
        M 15,10 A 1,1 0 1 0 15,10.1
    </Geometry>

    <!-- Sort -->
    <Geometry x:Key="IconSort">M 4,6 L 16,6 M 6,10 L 14,10 M 8,14 L 12,14</Geometry>

    <!-- Filter -->
    <Geometry x:Key="IconFilter">M 3,4 L 9,12 L 9,18 L 11,17 L 11,12 L 17,4 Z</Geometry>

    <!-- Reboot / Power-cycle -->
    <Geometry x:Key="IconReboot">
        M 10,4 L 10,10
        M 7,6 A 5,5 0 1 0 13,6
    </Geometry>

</ResourceDictionary>
